---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditorialPageHero from '@/components/layout/core/EditorialPageHero.astro';
import Container from '@/components/ui/core/Container.astro';

interface HeroProps {
  title: string;
  subtitle?: string;
  page: string;
}
const { title, description, hero, containerClass } = Astro.props as {
  title: string;
  description: string;
  hero: HeroProps;
  containerClass?: string;
};
---

<BaseLayout title={title} description={description} page={hero.page}>
  <Container className={containerClass || undefined}>
    <EditorialPageHero title={hero.title} subtitle={hero.subtitle} eyebrow="Field notes" />
    <div class="mt-8">
      <slot />
    </div>
  </Container>
  <slot name="after" />
  <!-- Optional named slot for content that should appear outside the container -->
</BaseLayout>
