---
import ListingShell from './ListingShell.astro';
import ProjectCard from '@/components/ui/cards/ProjectCard';
import TalkCard from '@/components/ui/cards/TalkCard';
import PublicationCard from '@/components/ui/publication/PublicationCard';
import { buildCollectionListing } from '@/lib/collection-listing';
import type { CollectionListingInput } from '@/lib/collection-listing';
type Props = CollectionListingInput;
const props = Astro.props;
const { kind } = props;
const entries = buildCollectionListing(props);
const fields = kind === 'talks' ? ['mode', 'year', 'audience'] : ['year', 'type'];
const placeholder =
  kind === 'publications'
    ? 'Search title, venue, authors...'
    : kind === 'projects'
      ? 'Search title, summary, collaborators...'
      : 'Search title, audience...';
---

<ListingShell
  items={entries.map(entry => entry.meta)}
  kind={kind}
  fields={fields}
  placeholder={placeholder}
  emptyTitle={`No matching ${kind}`}
  emptyCopy="Try a broader search, remove a tag, or reset the filters."
>
  <ul class="editorial-listing__featured" data-featured-list aria-label={`Featured ${kind}`}>
    {entries.slice(0, 1).map(entry => (
      <li
        id={entry.meta.id}
        data-listing-item
        data-featured={entries[0] === entry ? 'true' : 'false'}
        data-meta={JSON.stringify(entry.meta)}
        class="editorial-listing__item target-highlight h-full"
      >
        {entry.kind === 'projects' ? (
          <ProjectCard item={entry.item} featured />
        ) : entry.kind === 'talks' ? (
          <TalkCard item={entry.item} featured />
        ) : (
          <PublicationCard item={entry.item} featured />
        )}
      </li>
    ))}
  </ul>
  <ul class="editorial-listing__grid" data-grid-list aria-label={kind}>
    {entries.slice(1).map(entry => (
      <li
        id={entry.meta.id}
        data-listing-item
        data-featured={entries[0] === entry ? 'true' : 'false'}
        data-meta={JSON.stringify(entry.meta)}
        class="editorial-listing__item target-highlight h-full"
      >
        {entry.kind === 'projects' ? (
          <ProjectCard item={entry.item} />
        ) : entry.kind === 'talks' ? (
          <TalkCard item={entry.item} />
        ) : (
          <PublicationCard item={entry.item} />
        )}
      </li>
    ))}
  </ul>
</ListingShell>
