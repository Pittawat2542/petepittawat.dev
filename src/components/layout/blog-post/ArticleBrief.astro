---
interface Props {
  excerpt?: string | undefined;
}

const { excerpt } = Astro.props as Props;
---

{excerpt ? (
  <section class="article-brief" aria-label="TL;DR">
    <h2 class="article-brief__label">TL;DR</h2>
    <p class="article-brief__copy">{excerpt}</p>
  </section>
) : null}

<style>
  .article-brief {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    border-left: 2px solid var(--color-accent-primary);
    background: var(--color-surface-deep);
  }

  .article-brief__label,
  .article-brief__copy {
    position: relative;
    z-index: 1;
  }

  .article-brief__label {
    margin: 0;
    color: color-mix(in oklab, var(--accent-blog) 84%, var(--white) 20%);
    font-size: var(--type-caption);
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-brief__copy {
    margin: 0;
    max-width: 68ch;
    font-size: var(--type-body);
    line-height: 1.78;
    color: color-mix(in oklab, var(--white) 88%, transparent);
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .article-brief {
      border-radius: 0;
      padding: 1.1rem;
    }
  }
</style>
