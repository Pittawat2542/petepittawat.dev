---
import { ArrowUp } from 'lucide-react';
---

<button
  type="button"
  data-scroll-top
  aria-label="Back to top"
  aria-hidden="true"
  inert
  title="Scroll to top"
  class="glass-button bg-muted/20 border-muted/40 hover:bg-muted/30 hover:border-muted/60 pointer-events-none fixed right-6 bottom-6 z-30 inline-flex h-11 w-11 translate-y-2 items-center justify-center rounded-full text-[color:var(--white)] opacity-0 shadow-md shadow-black/10 transition-[opacity,transform,box-shadow,color,background-color,border-color] duration-200 ease-out will-change-transform hover:text-[color:var(--accent)] active:scale-[0.98] motion-reduce:transition-none"
  style="right:max(1.25rem, env(safe-area-inset-right));bottom:max(1.25rem, env(safe-area-inset-bottom))"
  data-visible="false"
>
  <ArrowUp className="h-5 w-5" aria-hidden="true" />
</button>
