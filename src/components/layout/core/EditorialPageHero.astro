---
import '@/styles/components/editorial-page-hero.css';

interface Props {
  title: string;
  subtitle?: string | undefined;
  eyebrow?: string;
  collectionLabel?: string;
}

const {
  title,
  subtitle,
  eyebrow = 'Overview',
  collectionLabel = 'In this collection',
} = Astro.props as Props;
const hasSupport = Astro.slots.has('support');
---

<header class:list={['editorial-page-hero', { 'editorial-page-hero--with-index': hasSupport }]}>
  <div class="editorial-page-hero__inner">
    <p class="editorial-page-hero__eyebrow">
      <span class="editorial-page-hero__eyebrow-dot" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="editorial-page-hero__title">{title}</h1>
    {subtitle && <p class="editorial-page-hero__subtitle">{subtitle}</p>}
  </div>
  {hasSupport && (
    <aside class="editorial-page-hero__support" aria-label={collectionLabel}>
      <p class="editorial-page-hero__index-label">{collectionLabel}</p>
      <slot name="support" />
    </aside>
  )}
</header>
