---
interface Props {
  variant?: 'landing' | 'article' | undefined;
  style?: string | undefined;
}
const { variant = 'landing', style } = Astro.props as Props;
---

<div class="page-backdrop" data-variant={variant} aria-hidden="true" style={style}></div>
<style>
  .page-backdrop {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: var(--surface-page);
  }
</style>
