---
import { ArrowRight } from 'lucide-react';

type CtaIcon = (typeof import('lucide-react'))['BookText'];

interface CtaToken {
  readonly accent: string;
  readonly accentMuted: string;
  readonly glow: string;
}

interface Props {
  readonly href: string;
  readonly title: string;
  readonly description: string;
  readonly ctaLabel: string;
  readonly Icon: CtaIcon;
  readonly token: CtaToken;
}

const { href, title, description, ctaLabel, Icon, token } = Astro.props as Props;
---

<a
  href={href}
  class="hero-cta-card"
  style={{
    '--hero-cta-accent': token.accent,
    '--hero-cta-accent-muted': token.accentMuted,
    '--hero-cta-glow': token.glow,
  }}
>
  <span class="hero-cta-card__header">
    <span class="hero-cta-card__icon-shell" aria-hidden="true">
      <Icon className="hero-cta-card__icon" aria-hidden="true" />
    </span>
    <span class="hero-cta-card__title">{title}</span>
  </span>

  <span class="hero-cta-card__description">{description}</span>

  <span class="hero-cta-card__link">
    <span>{ctaLabel}</span>
    <ArrowRight className="hero-cta-card__arrow" aria-hidden="true" />
  </span>
</a>

<style>
  .hero-cta-card {
    display: grid;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem 0;
    border-block: 1px solid var(--editorial-rule);
    color: var(--text-primary);
    text-decoration: none;
  }
  .hero-cta-card__header,
  .hero-cta-card__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .hero-cta-card__icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--hero-cta-accent);
  }
  .hero-cta-card__title {
    font-size: var(--type-body-lg);
    font-weight: 600;
  }
  .hero-cta-card__description {
    max-width: 36ch;
    color: var(--color-canvas-muted);
    font-size: var(--type-control);
    line-height: 1.8;
  }
  .hero-cta-card__link {
    justify-content: space-between;
    align-self: end;
    color: var(--hero-cta-accent);
    font-size: var(--type-control);
    font-weight: 600;
  }
  .hero-cta-card__arrow {
    width: 1rem;
    height: 1rem;
  }
  .hero-cta-card:hover .hero-cta-card__title {
    color: var(--hero-cta-accent);
  }
  .hero-cta-card:focus-visible {
    outline: 2px solid var(--hero-cta-accent);
    outline-offset: 5px;
  }
</style>
