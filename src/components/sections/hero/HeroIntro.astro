---
import type { SiteCopy } from '@/data/site/copy';
import HeroTopicList from '@/components/sections/hero/HeroTopicList.astro';
import { displayName, getIntroVariant } from '@/components/sections/hero/hero-data';

interface Props {
  copy: SiteCopy['home']['hero'];
}

const { copy } = Astro.props as Props;

const [givenName = displayName, ...familyNameParts] = displayName.split(' ');
const familyName = familyNameParts.join(' ');
const introVariant = getIntroVariant(copy.intro);
---

<div class="hero-copy order-1 md:col-span-1">
  <div class="hero-copy__inner">
    <div class="hero-statement">
      <p class="hero-eyebrow">Research &amp; engineering</p>
      <h1 class="hero-name">
        <span class="hero-name__given">{givenName}</span>
        {familyName && <span class="hero-name__family">{familyName}</span>}
      </h1>

      <p class="hero-lead">
        {introVariant === 'en' ? (
          <>
            I study how language models <span>acquire</span>
            <br class="hidden sm:block" /> and <span>express behavior</span>.
          </>
        ) : introVariant === 'th' ? (
          <>
            ผมศึกษาว่าโมเดลภาษา<span>เรียนรู้</span>
            <br class="hidden sm:block" /> และ<span>แสดงพฤติกรรม</span>ออกมาอย่างไร
          </>
        ) : (
          copy.intro
        )}
      </p>

      <p class="hero-summary">{copy.summary}</p>
    </div>

    <HeroTopicList topics={copy.topics} />
  </div>
</div>

<style>
  .hero-copy {
    width: 100%;
    text-align: left;
  }
  .hero-copy__inner,
  .hero-statement {
    display: grid;
    gap: 1.35rem;
  }
  .hero-eyebrow {
    margin: 0;
    color: var(--color-canvas-muted);
    font-size: var(--type-meta);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-name {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }
  .hero-name__given {
    font-size: clamp(3.25rem, 6vw, 5.5rem);
  }
  .hero-name__family {
    font-size: clamp(1.55rem, 3.5vw, 2.7rem);
    overflow-wrap: anywhere;
  }
  .hero-lead {
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--editorial-serif);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .hero-lead span {
    color: var(--text-primary);
  }
  .hero-summary {
    max-width: 46ch;
    margin: 0;
    color: var(--color-canvas-muted);
    font-size: var(--type-body);
    line-height: 1.8;
  }
</style>
