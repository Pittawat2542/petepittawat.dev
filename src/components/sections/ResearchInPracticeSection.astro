---
import Container from '@/components/ui/core/Container.astro';
import type { SiteCopy } from '@/data/site/copy';
import { Activity, ArrowRight, BrainCircuit, ChartColumn, Network } from 'lucide-react';

interface Props {
  copy: SiteCopy['home']['researchInPractice'];
}

const { copy } = Astro.props as Props;

const pillarIcons = {
  activity: Activity,
  'chart-column': ChartColumn,
  'brain-circuit': BrainCircuit,
  network: Network,
} as const;

const pillarAccents = ['#89b9fa', '#b3a5f5', '#e7ba81', '#83d8c0'] as const;

const pillarItems = copy.pillars.map((pillar, index) => ({
  ...pillar,
  Icon: pillarIcons[pillar.icon],
  style: `--pillar-accent: ${pillarAccents[index] ?? pillarAccents[0]}`,
}));
---

<Container className="reveal mt-16">
  <section id="about" class="research-practice" aria-labelledby="research-practice-title">
    <div class="research-practice__intro">
      <p class="section-eyebrow research-practice__eyebrow">
        <span class="section-eyebrow__dot" aria-hidden="true"></span>
        {copy.eyebrow}
      </p>
      <h2 id="research-practice-title" class="research-practice__title">
        <span>{copy.title}</span>
        <span class="research-practice__title-accent">{copy.titleAccent}</span>
      </h2>
      <p class="research-practice__body">{copy.body}</p>
      <a class="research-practice__link" href={copy.ctaHref}>
        <span>{copy.ctaLabel}</span>
        <ArrowRight className="research-practice__link-icon" aria-hidden="true" />
      </a>
    </div>

    <div class="research-practice__pillars" aria-label="Research focus areas">
      {pillarItems.map(({ title, description, Icon, style }) => (
        <article class="research-practice__pillar" style={style}>
          <div class="research-practice__pillar-icon-shell" aria-hidden="true">
            <Icon className="research-practice__pillar-icon" />
          </div>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
</Container>

<style>
  .research-practice {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
    border-block: 1px solid var(--editorial-rule);
  }
  .research-practice__title {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0;
    color: var(--text-primary);
    font-family: var(--editorial-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.5;
  }
  .research-practice__body {
    max-width: 45ch;
    color: var(--color-canvas-muted);
    font-size: var(--type-body-sm);
    line-height: 1.8;
  }
  .research-practice__link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    color: var(--color-accent-primary);
    font-size: var(--type-control);
    text-decoration: none;
  }
  .research-practice__link-icon {
    width: 1rem;
    height: 1rem;
  }
  .research-practice__pillars {
    display: grid;
    gap: 1.5rem;
  }
  .research-practice__pillar {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--editorial-rule);
  }
  .research-practice__pillar-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--pillar-accent);
  }
  .research-practice__pillar h3 {
    margin: 0;
    font-size: var(--type-body-lg);
    font-weight: 600;
  }
  .research-practice__pillar p {
    margin: 0;
    color: var(--color-canvas-muted);
    font-size: var(--type-control);
    line-height: 1.75;
  }
  @media (min-width: 640px) {
    .research-practice__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .research-practice {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: 4rem;
    }
  }
</style>
