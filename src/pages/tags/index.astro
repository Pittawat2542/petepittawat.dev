---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import { SITE_CONFIG } from '@/lib/constants';
import { getPreferredBlogPosts, groupBlogPostsByTranslation } from '@/lib/blog-translations';
import { slugifyTag } from '@/lib/slug';
import PageWithHero from '@/layouts/PageWithHero.astro';
import '@/styles/components/editorial-directory.css';

const posts = getPreferredBlogPosts(groupBlogPostsByTranslation(await getCollection('blog')), 'en');
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
}
const tags = [...tagCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<PageWithHero
  title={`${SITE_CONFIG.title} - Tags`}
  description={SITE_CONFIG.description}
  hero={{
    title: 'Topics',
    subtitle: 'Follow an idea through the archive. Explore writing by subject.',
    page: 'blog',
  }}
>
  <div class="directory-toolbar">
    <p>
      {tags.length} topics across {posts.length} posts
    </p>
    <label for="topic-sort">
      Sort by
      <select id="topic-sort">
        <option value="name">Name</option>
        <option value="count">Most posts</option>
      </select>
    </label>
  </div>
  <ul class="topic-directory" data-topic-directory>
    {tags.map(([name, count]) => (
      <li data-name={name} data-count={count}>
        <a href={`/tags/${slugifyTag(name)}`}>
          <span class="topic-directory__name">
            <span aria-hidden="true">#</span>
            {name}
          </span>
          <span class="topic-directory__count">
            {count} {count === 1 ? 'post' : 'posts'}
          </span>
          <ArrowRight aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
</PageWithHero>

<script>
  const list = document.querySelector<HTMLUListElement>('[data-topic-directory]');
  const select = document.querySelector<HTMLSelectElement>('#topic-sort');
  if (list && select) {
    const sortTopics = () => {
      const items = [...list.querySelectorAll<HTMLLIElement>('li')];
      items.sort((a, b) => {
        const nameOrder = (a.dataset['name'] ?? '').localeCompare(b.dataset['name'] ?? '');
        return select.value === 'count'
          ? Number(b.dataset['count']) - Number(a.dataset['count']) || nameOrder
          : nameOrder;
      });
      list.append(...items);
    };
    select.value = new URL(location.href).searchParams.get('sort') === 'count' ? 'count' : 'name';
    sortTopics();
    select.addEventListener('change', sortTopics);
  }
</script>
