---
import '@/styles/components/research-page.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/core/Container.astro';
import PageBackdrop from '@/components/layout/core/PageBackdrop.astro';
import { siteCopyEn } from '@/data/site/copy';
import {
  RESEARCH_THEMES,
  assertResearchThemesResolved,
  resolveResearchThemeArtifacts,
} from '@/data/site/research-map';
import { SITE_CONFIG } from '@/lib/constants';
import { getBlogPosts, getProjects, getPublications, getTalks } from '@/lib/content';
import { getPreferredBlogPosts, groupBlogPostsByTranslation } from '@/lib/blog-translations';
import { ArrowRight, BookOpenText, Boxes, FileText, Mic } from 'lucide-react';

const pageCopy = siteCopyEn.listingPages.research;
const [blogPosts, projects, publications, talks] = await Promise.all([
  getBlogPosts(),
  getProjects(),
  getPublications(),
  getTalks(),
]);
const preferredBlogPosts = getPreferredBlogPosts(groupBlogPostsByTranslation(blogPosts), 'en');
const themes = resolveResearchThemeArtifacts(RESEARCH_THEMES, {
  blogPosts: preferredBlogPosts,
  projects,
  publications,
  talks,
});

assertResearchThemesResolved(themes);

const artifactIcons = {
  blog: BookOpenText,
  project: Boxes,
  publication: FileText,
  talk: Mic,
} as const;

const artifactLabels = {
  blog: 'Writing',
  project: 'Project',
  publication: 'Publication',
  talk: 'Talk',
} as const;

const themeStats = {
  publications: publications.length,
  talks: talks.length,
  projects: projects.length,
  posts: preferredBlogPosts.length,
};

const themeQuestions = [
  'How do we steer model behavior?',
  'How do we know what works?',
  'How can models reason better?',
  'How do we put models to work?',
];

const archiveLinks = [
  { label: 'Publications', count: themeStats.publications, href: '/publications', icon: FileText },
  { label: 'Talks', count: themeStats.talks, href: '/talks', icon: Mic },
  { label: 'Projects', count: themeStats.projects, href: '/projects', icon: Boxes },
  { label: 'Posts', count: themeStats.posts, href: '/blog', icon: BookOpenText },
];
---

<BaseLayout
  title={`${SITE_CONFIG.title} - ${pageCopy.title}`}
  description={pageCopy.metaDescription || SITE_CONFIG.description}
  page="research"
>
  <PageBackdrop />
  <Container className="research-page">
    <header class="research-hero">
      <div class="research-hero__copy">
        <p class="research-eyebrow">
          <span aria-hidden="true"></span> Research map
        </p>
        <h1>
          {pageCopy.title}
          <span aria-hidden="true">.</span>
        </h1>
        <p class="research-hero__lead">
          Making language models
          <br /> more reliable in practice.
        </p>
        <p class="research-hero__description">{pageCopy.heroSubtitle}</p>
        <a href="#research-directions" class="research-hero__cta">
          Explore the work <ArrowRight aria-hidden="true" />
        </a>
      </div>
      <nav class="research-index" aria-label="Research themes">
        <div class="research-index__heading">
          <span>Four connected directions</span>
          <span aria-hidden="true">01 — 04</span>
        </div>
        <ol>
          {themes.map((theme, index) => (
            <li>
              <a href={`#${theme.id}`}>
                <span class="research-index__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="research-index__body">
                  <span class="research-index__title">{theme.title}</span>
                  <span class="research-index__question">{themeQuestions[index]}</span>
                </span>
                <ArrowRight aria-hidden="true" />
              </a>
            </li>
          ))}
        </ol>
        <p class="research-index__note">From research questions to working systems.</p>
      </nav>
    </header>

    <nav class="research-archive" aria-label="Browse the full archive">
      <p class="research-eyebrow">Across the archive</p>
      <ul>
        {archiveLinks.map(({ label, count, href, icon: Icon }) => (
          <li>
            <a href={href}>
              <Icon className="research-archive__icon" aria-hidden="true" />
              <span class="research-archive__count">{count}</span>
              <span>{label}</span>
              <ArrowRight className="research-archive__arrow" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="research-directions" id="research-directions">
      <div class="research-directions__intro">
        <h2>Follow a research thread</h2>
        <p>Start with a question. Explore the work behind it.</p>
      </div>
      {themes.map((theme, themeIndex) => (
        <section id={theme.id} class="research-theme" aria-labelledby={`${theme.id}-title`}>
          <div class="research-map-theme__header">
            <p class="research-map-theme__kicker">
              Theme {String(themeIndex + 1).padStart(2, '0')}
            </p>
            <h3 id={`${theme.id}-title`} class="research-map-theme__title">
              {theme.title}
            </h3>
            <p class="research-map-theme__summary">{theme.summary}</p>
            <ul class="research-map-theme__tags" aria-label={`${theme.title} representative tags`}>
              {theme.representativeTags.map(tag => (
                <li>{tag}</li>
              ))}
            </ul>
            {theme.startHere ? (
              <a class="research-map-theme__start" href={theme.startHere.href}>
                <span>
                  <span class="research-map-theme__start-label">Suggested starting point</span>
                  <span class="research-map-theme__start-title">{theme.startHere.title}</span>
                </span>
                <ArrowRight className="research-map-theme__start-icon" aria-hidden="true" />
              </a>
            ) : null}
          </div>

          <ul class="research-map-artifacts" aria-label={`${theme.title} artifacts`}>
            {theme.artifacts.map(artifact => {
              const Icon = artifactIcons[artifact.type];
              return (
                <li class="research-map-artifact">
                  <a class="research-map-artifact__link" href={artifact.href}>
                    <span class="research-map-artifact__body">
                      <span class="research-map-artifact__details">
                        <span class="research-map-artifact__type">
                          <Icon className="research-map-artifact__type-icon" aria-hidden="true" />
                          {artifactLabels[artifact.type]}
                        </span>
                        <span class="research-map-artifact__meta">{artifact.meta}</span>
                      </span>
                      <span class="research-map-artifact__title">{artifact.title}</span>
                      <span class="research-map-artifact__description">{artifact.description}</span>
                    </span>
                    <ArrowRight className="research-map-artifact__arrow" aria-hidden="true" />
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
    <aside class="research-continue" aria-label="Continue exploring">
      <div>
        <p class="research-eyebrow">Keep exploring</p>
        <h2>The ideas continue in the writing.</h2>
        <p>Field notes, experiments, and lessons from building with language models.</p>
      </div>
      <a href="/blog">
        Read the field notes <ArrowRight aria-hidden="true" />
      </a>
    </aside>
  </Container>
</BaseLayout>
