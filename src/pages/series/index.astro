---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import '@/styles/components/editorial-directory.css';
import FormattedDate from '@/components/content/FormattedDate';
import { SITE_CONFIG } from '@/lib/constants';
import {
  getBlogPostPath,
  getPreferredBlogPosts,
  groupBlogPostsByTranslation,
} from '@/lib/blog-translations';
import { estimateReadingMetrics } from '@/lib/reading-time';
import { getAllSeries } from '@/lib/series';
import PageWithHero from '@/layouts/PageWithHero.astro';

const allPosts = getPreferredBlogPosts(
  groupBlogPostsByTranslation(await getCollection('blog')),
  'en'
);
const allSeries = getAllSeries(allPosts);

// Sort series by the most recent post date
allSeries.sort((a, b) => {
  const latestA = Math.max(...a.posts.map(p => p.data.pubDate.valueOf()));
  const latestB = Math.max(...b.posts.map(p => p.data.pubDate.valueOf()));
  return latestB - latestA;
});
---

<PageWithHero
  title={`${SITE_CONFIG.title} - Series`}
  description={`${SITE_CONFIG.description} - Explore multi-part blog series`}
  hero={{
    title: 'Blog Series',
    subtitle:
      'Ideas worth following further. Multi-part guides and connected essays from the archive.',
    page: 'blog',
  }}
>
  <div class="directory-toolbar">
    <p>{allSeries.length} series in the archive</p>
    <a class="series-directory__link" href="/blog">
      All posts <ArrowRight aria-hidden="true" />
    </a>
  </div>
  <div class="series-directory">
    {allSeries.length > 0 ? (
      allSeries.map(series => {
        const firstPost = series.posts[0];
        const lastPost = series.posts[series.posts.length - 1];
        const totalReadingTime = series.posts.reduce(
          (total, post) => total + estimateReadingMetrics(post.body || '').readingTimeMin,
          0
        );
        return (
          <article>
            <header>
              <h2>{series.title}</h2>
              {series.description && <p>{series.description}</p>}
              <div class="series-directory__meta">
                <span>
                  {series.totalParts} {series.totalParts === 1 ? 'part' : 'parts'}
                </span>
                <span>~{totalReadingTime} min total</span>
                <span>Updated {lastPost && <FormattedDate date={lastPost.data.pubDate} />}</span>
              </div>
            </header>
            <ol>
              {series.posts.map((post, index) => (
                <li>
                  <a href={getBlogPostPath(post)}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{post.data.title}</h3>
                      <FormattedDate date={post.data.pubDate} />
                    </div>
                    <ArrowRight aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ol>
            {firstPost && (
              <a class="series-directory__link" href={getBlogPostPath(firstPost)}>
                Start reading <ArrowRight aria-hidden="true" />
              </a>
            )}
          </article>
        );
      })
    ) : (
      <article>
        <h2>More threads to follow, soon.</h2>
        <p>In the meantime, explore individual essays, tutorials, and field notes.</p>
        <a class="series-directory__link" href="/blog">
          Browse the writing <ArrowRight aria-hidden="true" />
        </a>
      </article>
    )}
  </div>
</PageWithHero>
