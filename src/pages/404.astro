---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditorialPageHero from '@/components/layout/core/EditorialPageHero.astro';
import Container from '@/components/ui/core/Container.astro';
import { ArrowRight, Search } from 'lucide-react';
Astro.response.status = 404;
const destinations = [
  { href: '/research', title: 'Research', description: 'Follow the questions behind the work.' },
  { href: '/blog', title: 'Writing', description: 'Essays, experiments, and field notes.' },
  { href: '/projects', title: 'Projects', description: 'Tools and systems built along the way.' },
  { href: '/publications', title: 'Publications', description: 'The full research record.' },
];
---

<BaseLayout title="404 - Page Not Found" description="The page you were looking for doesn't exist.">
  <Container>
    <EditorialPageHero
      eyebrow="A small detour"
      title="404"
      subtitle="This page is missing. There is still plenty to explore."
    />
    <nav class="recovery-actions" aria-label="Find your way">
      <a href="/">
        Go to homepage <ArrowRight aria-hidden="true" />
      </a>
      <button id="open-search" type="button">
        <Search aria-hidden="true" /> Search the site
      </button>
    </nav>
    <nav class="recovery-links" aria-label="Explore the site">
      {destinations.map(({ href, title, description }) => (
        <a href={href}>
          <span>
            <strong>{title}</strong>
            <span>{description}</span>
          </span>
          <ArrowRight aria-hidden="true" />
        </a>
      ))}
    </nav>
  </Container>
  <script is:inline>
    // Wire up the page button to open the header search
    const btn = document.getElementById('open-search');
    const openSearch = () => {
      const triggers = document.querySelectorAll('button[aria-label="Open search"]');
      for (const t of triggers) {
        if (typeof t.click === 'function') {
          t.click();
          break;
        }
      }
    };
    if (btn) btn.addEventListener('click', openSearch);
  </script>
</BaseLayout>

<style>
  .recovery-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block: 2rem 3rem;
  }
  .recovery-actions :is(a, button) {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--editorial-rule);
    border-radius: var(--editorial-control-radius);
    color: var(--text-primary);
    font-size: var(--type-control);
    text-decoration: none;
    cursor: pointer;
  }
  .recovery-actions svg,
  .recovery-links svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-accent-primary);
  }
  .recovery-links {
    display: grid;
    gap: 0 3rem;
  }
  .recovery-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--editorial-rule);
    color: var(--text-primary);
    text-decoration: none;
  }
  .recovery-links a > span {
    display: grid;
    gap: 0.5rem;
  }
  .recovery-links strong {
    font-size: var(--type-body-lg);
    font-weight: 600;
  }
  .recovery-links span span {
    color: var(--color-canvas-muted);
    font-size: var(--type-control);
    line-height: 1.75;
  }
  :is(.recovery-links a, .recovery-actions a, .recovery-actions button):focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 4px;
  }
  @media (min-width: 720px) {
    .recovery-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
