{
  "name": "petepittawat.dev",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node --run generate:content-images",
    "build": "astro check && astro build && node scripts/performance/audit-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && astro check && tsc --noEmit",
    "lint:fix": "eslint src --ext .ts,.tsx,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:content": "node --test scripts/content-image.test.ts scripts/blog-content-audit.test.mjs scripts/translate-blog-post.test.mjs scripts/translate-blog-post-lib.test.mjs src/lib/blog-translations.test.ts src/lib/blog-locale-preference.test.ts src/lib/blog-cover/index.test.ts src/lib/card-visual/index.test.ts src/lib/blog-post-schema.test.ts src/lib/about-timeline.test.ts src/lib/reading-time.test.ts src/lib/toc.test.ts src/lib/blog-recommendations.test.ts src/lib/search-page-items.test.ts src/data/site/copy.test.ts src/data/site/research-map.test.ts src/components/ui/cards/cardOverflow.test.ts src/components/layout/core/footer-social-links.test.ts src/styles/typography.architecture.test.ts src/lib/listing.test.ts",
    "validate:cover-assets": "node --experimental-strip-types scripts/validate-cover-assets.ts",
    "generate:content-images": "node --experimental-strip-types scripts/generate-site-cover.ts && node --experimental-strip-types scripts/generate-card-visuals.ts && node --experimental-strip-types scripts/generate-og.ts && node --experimental-strip-types scripts/validate-cover-assets.ts",
    "generate:site-cover": "node --experimental-strip-types scripts/generate-site-cover.ts",
    "prompt:site-cover": "node --experimental-strip-types scripts/generate-site-cover.ts --prompt",
    "clean": "rm -rf dist .astro node_modules/.astro",
    "dev:clean": "npm run clean && npm run dev",
    "generate-favicons": "./scripts/generate-favicons.sh",
    "audit:blog-cover": "node --experimental-strip-types scripts/blog-cover-audit.ts",
    "translate-blog-post": "node scripts/translate-blog-post.mjs",
    "prepare": "husky",
    "update-deps": "node scripts/update-dependencies.mjs",
    "audit:performance": "node scripts/performance/audit-build.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,json,md,css,js,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/krub": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-robots-txt": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "packageManager": "pnpm@10.18.3"
}
